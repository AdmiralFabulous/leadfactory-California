## 9) End‑to‑end reference examples

### 9.1 Multi‑agent chain (YAML)

```yaml
version: '1.0'
blocks:
  start:
    type: starter
    name: Start
    inputs:
      startWorkflow: manual
    connections:
      success: agent-1-initiator

  agent-1-initiator:
    type: agent
    name: Agent 1 Initiator
    inputs:
      systemPrompt: You are the first agent in a chain.
      userPrompt: |
        Input to process: <start.input>
      model: gpt-4o
      temperature: 0.7
      apiKey: '{{OPENAI_API_KEY}}'
    connections:
      success: agent-2-enhancer

  agent-2-enhancer:
    type: agent
    name: Agent 2 Enhancer
    inputs:
      systemPrompt: You are the second agent. Enhance prior output.
      userPrompt: <agent1initiator.content>
      model: gpt-4o
      temperature: 0.7
      apiKey: '{{OPENAI_API_KEY}}'
    connections:
      success: agent-3-refiner

  agent-3-refiner:
    type: agent
    name: Agent 3 Refiner
    inputs:
      systemPrompt: Refine & structure the text.
      userPrompt: <agent2enhancer.content>
      model: gpt-4o
      temperature: 0.6
      apiKey: '{{OPENAI_API_KEY}}'
    connections:
      success: response

  response:
    type: response
    name: Return
    inputs:
      Status Code: 200
      Response Data: |
        { "final": "<agent3refiner.content>" }
```

### 9.2 Router with multiple targets (YAML)

```yaml
version: '1.0'
blocks:
  start:
    type: starter
    name: Start
    inputs: { startWorkflow: manual }
    connections: { success: router }

  router:
    type: router
    name: Intent Router
    inputs:
      prompt: |
        If input is a question -> q-agent
        If instruction -> cmd-agent
        Else -> smalltalk-agent
        Content: <start.input>
      model: gpt-4o
      apiKey: '{{OPENAI_API_KEY}}'
    connections:
      success: [q-agent, cmd-agent, smalltalk-agent]
```

### 9.3 API → Condition → Function → Response (YAML)

```yaml
version: '1.0'
blocks:
  start:
    type: starter
    name: Start
    inputs: { startWorkflow: manual }
    connections: { success: fetch }

  fetch:
    type: api
    name: Fetch User
    inputs:
      url: "https://api.example.com/users/123"
      method: GET
      headers:
        - id: h1
          cells: { Key: "Authorization", Value: "Bearer {{API_TOKEN}}" }
    connections:
      success: ok?
      error: api-error

  ok?:
    type: condition
    name: Status OK?
    inputs: { condition: <fetch.status> >= 200 && <fetch.status> < 300 }
    connections: { true: shape, false: api-error }

  shape:
    type: function
    name: Shape Output
    inputs:
      code: |
        const u = <fetch.data>;
        return { id: u.id, email: u.email, active: true };
    connections: { success: respond }

  api-error:
    type: function
    name: API Error
    inputs:
      code: |
        return { error: true, status: <fetch.status>, data: <fetch.data> };
    connections: { success: respond }

  respond:
    type: response
    name: Respond
    inputs:
      Status Code: 200
      Response Data: |
        { "result": "<shape.output>", "error": "<apierror.output>" }
```

### 9.4 Loop & Parallel patterns (YAML)

```yaml
# Loop (sequential)
version: '1.0'
blocks:
  start:
    type: starter
    name: Start
    inputs: { startWorkflow: manual }
    connections: { success: items-loop }

  items-loop:
    type: loop
    name: Items Loop
    inputs: { loopType: forEach, collection: '["a","b","c"]' }
    connections:
      loop:
        start: process-item

  process-item:
    type: agent
    name: Per Item
    inputs:
      systemPrompt: Echo the item.
      userPrompt: <loop.currentItem>
      model: gpt-4o
      apiKey: '{{OPENAI_API_KEY}}'
    parentId: items-loop
```

```yaml
# Parallel (concurrent)
version: '1.0'
blocks:
  start: { type: starter, name: Start, inputs: { startWorkflow: manual }, connections: { success: run } }

  run:
    type: parallel
    name: Fanout
    inputs: { parallelType: collection, collection: '[1,2,3,4]' }
    connections:
      loop:
        start: worker

  worker:
    type: function
    name: Worker
    inputs:
      code: |
        const i = <parallel.currentItem>;
        return { i, square: i*i };
    parentId: run
```

