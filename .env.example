# QuickScraper
QUICKSCRAPER_ACCESS_TOKEN=your_quickscraper_access_token_here
# optional: QuickScraper email parser subscription ID
QUICKSCRAPER_EMAIL_PARSER_ID=

# Claude / Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Lead sources (JSON list of URLs)
LEAD_SOURCES_JSON=["https://www.reddit.com/r/IWantOut/","https://www.reddit.com/r/CaliforniaHousing/","https://www.facebook.com/groups/CaliforniansAbroad/"]

# Email / SMTP settings
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=Alex from Emigre.eu
SMTP_USE_TLS=true

# Outreach + scoring
MIN_INTENT_SCORE=0.7
DAILY_OUTREACH_LIMIT=40   # leads emailed per day
TARGET_DAILY_BOOKINGS=4   # just for logging/metrics

# Booking link (Calendly / Cal.com / Google booking page)
BOOKING_LINK=https://your-booking-link.example.com

# Database
DATABASE_URL=sqlite:///leadfactory.db

# Logging
LOG_LEVEL=INFO
