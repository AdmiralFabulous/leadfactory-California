# LeadFactory California - Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# ANTHROPIC (Required)
# ============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ============================================================================
# GOOGLE APIs (Required for email & calendar)
# ============================================================================
# Set up OAuth 2.0 credentials: https://console.cloud.google.com/
# Run scripts/setup_google_auth.py to get refresh token

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Email settings
GMAIL_SENDER_EMAIL=your-email@gmail.com
GMAIL_SENDER_NAME=Your Name

# Calendar settings
GOOGLE_CALENDAR_ID=primary  # or specific calendar ID
MEETING_DURATION_MINUTES=30

# ============================================================================
# REDDIT (Optional but recommended for lead sourcing)
# ============================================================================
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-secret
REDDIT_USER_AGENT=LeadFactoryBot/1.0 by YourRedditUsername

# ============================================================================
# LINKEDIN (Optional - harder to get API access)
# ============================================================================
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ============================================================================
# ENRICHMENT APIs (Optional - paid services)
# ============================================================================
# Apollo.io for contact enrichment
APOLLO_API_KEY=

# Hunter.io for email finding
HUNTER_API_KEY=

# Clearbit for company data
CLEARBIT_API_KEY=

# ============================================================================
# SEARCH & SCRAPING
# ============================================================================
# Google Custom Search (free tier: 100 queries/day)
# https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# SerpAPI (alternative, paid)
SERPAPI_KEY=

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# Core KPIs
DAILY_CALL_TARGET=4
MAX_DAILY_OUTREACH=150
MIN_LEAD_SCORE=60

# Geographic targeting
TARGET_STATE=California
TARGET_CITIES=San Francisco,Los Angeles,San Diego,San Jose,Oakland,Sacramento

# Time zone for scheduling
TIMEZONE=America/Los_Angeles

# Database
DATABASE_URL=sqlite:///data/leadfactory.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost/leadfactory

# Redis (optional, for production task queue)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# SCHEDULING
# ============================================================================

# When to run daily orchestration
ORCHESTRATOR_RUN_TIME=07:00
RESPONSE_CHECK_INTERVAL_MINUTES=60

# Follow-up sequence timing (days)
FOLLOWUP_DAY_1=3
FOLLOWUP_DAY_2=7

# ============================================================================
# OUTREACH SETTINGS
# ============================================================================

# Rate limiting (messages per hour by channel)
EMAIL_RATE_LIMIT_PER_HOUR=50
LINKEDIN_RATE_LIMIT_PER_HOUR=20
REDDIT_RATE_LIMIT_PER_HOUR=30

# Message personalization
PERSONALIZATION_LEVEL=high  # low, medium, high
USE_AB_TESTING=true

# ============================================================================
# COMPLIANCE & SAFETY
# ============================================================================

# Require compliance review for all messages
COMPLIANCE_REVIEW_ENABLED=true
COMPLIANCE_MIN_CONFIDENCE=0.85

# Include opt-out in emails
INCLUDE_OPTOUT_FOOTER=true

# Spam detection
SPAM_CHECK_ENABLED=true

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=data/logs/leadfactory.log

# Sentry (optional, for error tracking)
SENTRY_DSN=

# ============================================================================
# DASHBOARD
# ============================================================================

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=change-this-to-random-string

# ============================================================================
# DEVELOPMENT
# ============================================================================

# Set to true to prevent actual API calls
DRY_RUN=false

# Debug mode
DEBUG=false

# Test mode (uses smaller batches)
TEST_MODE=false
